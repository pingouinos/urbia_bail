# Copier ce fichier en .env puis remplir les valeurs.

# Clé secrète Django : une longue chaîne aléatoire, par exemple
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=false
# Nom ou adresse IP du NAS tel que saisi dans le navigateur.
ALLOWED_HOSTS=urbiabail.agence.local,192.168.1.10
CSRF_TRUSTED_ORIGINS=https://urbiabail.agence.local
# true dès que l'application est servie en HTTPS (proxy inverse du Synology).
SECURE_COOKIES=false
PORT=8000

POSTGRES_PASSWORD=

# Dossiers du NAS (chemins côté Synology).
DOCUMENTS_HOST_DIR=/volume1/UrbiaBail/documents
DB_HOST_DIR=/volume1/docker/urbiabail/postgres

# --- Annuaire Synology --------------------------------------------------------
LDAP_ENABLED=false
# ad = paquet « Synology Directory Server » ; posix = paquet « LDAP Server ».
LDAP_GROUP_TYPE=ad
LDAP_SERVER_URI=ldap://nas.agence.local
LDAP_START_TLS=false
# Compte de service en lecture seule utilisé pour chercher les utilisateurs.
LDAP_BIND_DN=CN=urbiabail-service,CN=Users,DC=agence,DC=local
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=CN=Users,DC=agence,DC=local
# LDAP_GROUP_BASE_DN=
# Groupe dont les membres ont accès à l'application.
LDAP_GROUPE_ACCES=CN=UrbiaBail,CN=Users,DC=agence,DC=local
# Groupe dont les membres sont administrateurs de l'application.
LDAP_GROUPE_ADMIN=CN=UrbiaBail-Admin,CN=Users,DC=agence,DC=local
