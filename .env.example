# Copier ce fichier en .env puis remplir les valeurs.

# Clé secrète Django : une longue chaîne aléatoire, par exemple
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=false
# Nom de domaine de l'application (enregistrement DNS A vers l'IP du VPS).
DOMAINE=bail.exemple.fr
ALLOWED_HOSTS=bail.exemple.fr
CSRF_TRUSTED_ORIGINS=https://bail.exemple.fr
HTTPS=true

POSTGRES_PASSWORD=

# Double authentification obligatoire pour tous les comptes.
MFA_OBLIGATOIRE=true

# --- Annuaire LDAP (facultatif, désactivé avec l'hébergement en ligne) -------
LDAP_ENABLED=false
# ad = « Synology Directory Server » / Active Directory ; posix = OpenLDAP.
# LDAP_GROUP_TYPE=ad
# LDAP_SERVER_URI=ldaps://annuaire.exemple.fr
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_USER_BASE_DN=
# LDAP_GROUPE_ACCES=
# LDAP_GROUPE_ADMIN=
