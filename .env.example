# Copier ce fichier en .env puis remplir les valeurs.

# Clé secrète Django : une longue chaîne aléatoire, par exemple
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=false
# Nom de domaine de l'application (enregistrement DNS A vers l'IP du VPS).
DOMAINE=bail.exemple.fr
ALLOWED_HOSTS=bail.exemple.fr
CSRF_TRUSTED_ORIGINS=https://bail.exemple.fr
HTTPS=true

POSTGRES_PASSWORD=

# --- Connexion Google Workspace -----------------------------------------------
# Domaine Workspace de l'agence : seuls ses comptes peuvent se connecter.
GOOGLE_DOMAINE=agence.fr
# Identifiants OAuth « Application Web » créés dans la console Google Cloud,
# URI de redirection autorisée : https://<DOMAINE>/oidc/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# true : un compte du domaine est créé comme gestionnaire à sa première
# connexion ; false : un administrateur crée d'abord le compte (même e-mail).
GOOGLE_CREATION_AUTO=false

# --- E-mails aux candidats -----------------------------------------------------
# Compte Google Workspace de l'agence avec un mot de passe d'application
# (le @ de l'adresse s'écrit %40) :
#   EMAIL_URL=smtp+tls://agence%40exemple.fr:motdepasse@smtp.gmail.com:587
# Sans EMAIL_URL, la réponse au candidat s'envoie à la main depuis Gmail.
EMAIL_URL=
# Expéditeur affiché : la même adresse que le compte ci-dessus.
DEFAULT_FROM_EMAIL=URBIA Immobilier <agence@exemple.fr>

# --- Formulaire des candidats retenus ------------------------------------------
# Adresse publique où le candidat retenu complète ses informations par le lien
# reçu. Sur cette adresse, seules les pages /locataire/ répondent. Vide : le
# lien utilise l'adresse de l'application.
URL_LOCATAIRES=

# Double authentification TOTP obligatoire pour les comptes locaux de secours.
MFA_OBLIGATOIRE=true
