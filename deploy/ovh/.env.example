# Réglages de production, à copier en .env dans /srv/clefaria puis à remplir.
# Ce fichier contient des secrets : ne jamais le publier ni l'envoyer par e-mail.

# Adresse de l'application (enregistrement DNS A vers l'IP de l'instance).
DOMAINE=app.clefaria.fr

# Deux longues chaînes aléatoires, à générer sur l'instance avec :
#   openssl rand -hex 32
# Le mot de passe de la base ne se change plus une fois la base créée.
SECRET_KEY=
POSTGRES_PASSWORD=

DEBUG=false
MFA_OBLIGATOIRE=true

# --- Connexion Google Workspace (plus tard) ------------------------------------
# Vides : seuls les comptes locaux avec double authentification fonctionnent.
# URI de redirection à déclarer chez Google : https://<DOMAINE>/oidc/callback/
GOOGLE_DOMAINE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREATION_AUTO=false

# --- E-mails aux candidats ------------------------------------------------------
# Compte Google de l'agence avec un mot de passe d'application (@ s'écrit %40) :
#   EMAIL_URL=smtp+tls://agence%40exemple.fr:motdepasse@smtp.gmail.com:587
# Vide : la réponse au candidat se copie dans Gmail à la main.
EMAIL_URL=
DEFAULT_FROM_EMAIL=URBIA Immobilier <agence@exemple.fr>
