# Copier ce fichier en .env (dans ce même dossier deploy/nas) puis remplir.
# Configuration de TEST sur le NAS, en HTTP sur le réseau local.

# Longue chaîne aléatoire (différente de celle du VPS).
SECRET_KEY=
POSTGRES_PASSWORD=
DEBUG=false

# Adresse IP locale du NAS (Panneau de configuration > Réseau > Interface réseau).
ALLOWED_HOSTS=192.168.1.10
CSRF_TRUSTED_ORIGINS=http://192.168.1.10:8080

# Pas de HTTPS sur le réseau local : cookies non sécurisés acceptés.
HTTPS=false

# Connexion Google désactivée : Google refuse les adresses de retour en HTTP
# hors localhost. On teste avec les comptes locaux (double authentification).
MFA_OBLIGATOIRE=true
